{$SITE_ADDRESS} {
    encode gzip

    # Backend API + docs
    @api path /api/* /docs /openapi.json
    handle @api {
        reverse_proxy backend:8000 {
            flush_interval -1
            # Real client IP for analytics (backend stores only a salted hash).
            header_up X-Real-IP {remote_host}
        }
    }

    # Everything else → Next.js
    handle {
        reverse_proxy frontend:3000
    }
}
