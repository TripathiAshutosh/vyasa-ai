# ========= Root .env used by docker-compose =========
# Copy to .env (which is gitignored) and fill in your real keys here.

# Provider switch: openai | opensource
PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Open source (Groq LLM + Jina embeddings/reranker) ---
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Whether to use the reranker (recommended, needs JINA_API_KEY)
USE_RERANKER=true

# REQUIRED: protects /upload, /refresh, /delete endpoints.
ADMIN_TOKEN=please-change-me

# RAG knobs
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=8
RERANK_TOP_K=5
EMBED_BATCH_SIZE=32

# Caddy site address. Use a domain for prod (auto-TLS via Let's Encrypt),
# or ":80" for plain HTTP / IP-only access.
SITE_ADDRESS=:80

# Host-side ports. Override locally if 80/443 are taken (e.g. HTTP_PORT=8080).
HTTP_PORT=80
HTTPS_PORT=443
