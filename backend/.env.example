# ====== Provider switch ======
# openai | opensource
PROVIDER=openai

# ====== OpenAI (used when PROVIDER=openai) ======
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ====== Open source (used when PROVIDER=opensource) ======
# LLM via Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Embeddings + Reranker via Jina
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Optional: reranker boosts answer quality. Requires JINA_API_KEY.
USE_RERANKER=true

# ====== Admin ======
# REQUIRED for upload/refresh/delete endpoints. Change before deploying.
ADMIN_TOKEN=change-me

# ====== Storage ======
DATA_DIR=./data
CHROMA_DIR=./chroma_db

# ====== RAG knobs ======
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=8
RERANK_TOP_K=5
EMBED_BATCH_SIZE=32

# ====== CORS ======
CORS_ORIGINS=http://localhost:3000
